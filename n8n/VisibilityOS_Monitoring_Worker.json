{
  "name": "VisibilityOS Monitoring Worker",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-920, 0],
      "id": "bc17e294-d3ee-40b5-8ed6-17f2ac60aef3",
      "name": "Hourly Scheduler"
    },
    {
      "parameters": {
        "jsCode": "const baseUrl = 'https://www.vladkuzmenko.com';\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nreturn ['daily', 'weekly'].map((jobType) => {\n  const body = JSON.stringify({ jobType, limit: 20 });\n  return {\n    json: {\n      baseUrl,\n      jobType,\n      body,\n      timestamp,\n      signingValue: `${timestamp}.${body}`,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 0],
      "id": "3b3c6be3-ab42-42ad-8e78-6c2cdda9034e",
      "name": "Prepare Job Pulls"
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signingValue }}",
        "dataPropertyName": "signatureDigest",
        "encoding": "HEX"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [-430, 0],
      "id": "0292c65e-5213-4280-ae74-23d0c8e2315e",
      "name": "Sign Job Pull"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl + '/api/visibilityos/automation/jobs' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"},
            {"name": "x-visibilityos-timestamp", "value": "={{ $json.timestamp }}"},
            {"name": "x-visibilityos-signature", "value": "={{ 'v1=' + $json.signatureDigest }}"}
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {"timeout": 20000}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-180, 0],
      "id": "3919f112-f2fe-4d1e-ac1f-d5e371e8e3ba",
      "name": "Claim Due Jobs"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\nfor (const item of $input.all()) {\n  const jobs = Array.isArray(item.json.jobs) ? item.json.jobs : [];\n  for (const job of jobs) {\n    output.push({\n      json: {\n        ...job,\n        scanEndpoint: job.jobType === 'daily'\n          ? 'https://www.vladkuzmenko.com/api/visibilityos/health'\n          : 'https://www.vladkuzmenko.com/api/visibilityos/scan',\n      },\n    });\n  }\n}\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [70, 0],
      "id": "0e2c4170-cbb7-4d00-9d2e-183addee6f80",
      "name": "Flatten Jobs"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.scanEndpoint }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.scanPayload }}",
        "options": {"timeout": 60000}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 0],
      "id": "a56e884b-bea6-4b5d-8d22-12bc0305aec6",
      "name": "Run Visibility Scan",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const job = $('Flatten Jobs').item.json;\nconst scan = $json;\nconst timestamp = Math.floor(Date.now() / 1000).toString();\n\nconst callback = scan && scan.ok === true && scan.result\n  ? {\n      projectId: job.projectId,\n      jobType: job.jobType,\n      idempotencyKey: job.idempotencyKey,\n      ok: true,\n      result: scan.result,\n      finishedAt: new Date().toISOString(),\n    }\n  : {\n      projectId: job.projectId,\n      jobType: job.jobType,\n      idempotencyKey: job.idempotencyKey,\n      ok: false,\n      error: String(scan?.error?.message || scan?.error || scan?.message || 'visibility_scan_failed').slice(0, 2000),\n      finishedAt: new Date().toISOString(),\n    };\n\nconst body = JSON.stringify(callback);\nreturn [{\n  json: {\n    ...callback,\n    body,\n    timestamp,\n    signingValue: `${timestamp}.${body}`,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [570, 0],
      "id": "ca3bfe99-2e70-47d4-b09b-9dfa67eca221",
      "name": "Prepare Callback"
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signingValue }}",
        "dataPropertyName": "signatureDigest",
        "encoding": "HEX"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [820, 0],
      "id": "a140c102-e9f1-45ce-871a-3585fe85f3f3",
      "name": "Sign Callback"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.vladkuzmenko.com/api/visibilityos/automation/callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"},
            {"name": "x-visibilityos-timestamp", "value": "={{ $json.timestamp }}"},
            {"name": "x-visibilityos-signature", "value": "={{ 'v1=' + $json.signatureDigest }}"}
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {"timeout": 20000}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1070, 0],
      "id": "efaef9da-f418-43c6-9239-478d34fc5614",
      "name": "Store Callback"
    }
  ],
  "pinData": {},
  "connections": {
    "Hourly Scheduler": {"main": [[{"node": "Prepare Job Pulls", "type": "main", "index": 0}]]},
    "Prepare Job Pulls": {"main": [[{"node": "Sign Job Pull", "type": "main", "index": 0}]]},
